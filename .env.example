NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Base URL of api-medicos-por-venezuela (SACS/FPV verification). Leave empty for local dev
# (defaults to http://localhost:8000).
NEXT_PUBLIC_API_URL=

# Optional: WhatsApp number (with country code, digits only) patients can message from /mi-caso.
# Leave empty to hide the "Continuar por WhatsApp" button.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Jitsi domain for video rooms. Leave empty to use the self-hosted default
# (meet.medicosporvenezuela.org — open rooms). Do NOT point it at public meet.jit.si:
# it now forces the first participant to log in as moderator and patients get stuck.
NEXT_PUBLIC_JITSI_DOMAIN=

# Base URL of the FastAPI backend (api-medicos-por-venezuela) that serves /api/v1/*.
# Used by lib/apiClient.ts. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=

# --- Server-only (NOT NEXT_PUBLIC). Never expose to the browser, never set in Amplify. ---
# Supabase service-role key. No runtime code reads it (the /api/videoconsulta route was removed);
# it is only needed LOCALLY so e2e/global-setup.ts can seed the test doctors against the LOCAL
# Supabase. Use the local CLI key (supabase status), never the prod one.
SUPABASE_SERVICE_ROLE_KEY=
# Twilio credentials (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Sandbox number for dev)
TWILIO_WHATSAPP_NUMBER=
# SMS sender used as fallback, e.g. +14155238886
TWILIO_SMS_NUMBER=

# --- Modo mantenimiento (feature flag) ---
# Pon "true" SOLO en el entorno que quieras dejar en mantenimiento (p. ej. la rama de producción
# en Amplify). Cualquier otro valor, o la variable ausente, deja el sitio normal.
# Con el flag activo, el sitio público muestra la página de mantenimiento; siguen abiertas las
# rutas de personal (/login-medico, /admin, /panel-medico) y las de pacientes que ya tienen un caso
# en curso (/sala-espera, /mi-caso), para no cortar una videoconsulta a medias. Ver middleware.ts.
# NO lleva NEXT_PUBLIC_: se resuelve en el servidor y no viaja al navegador.
# Se lee al construir, así que activarlo o desactivarlo requiere un nuevo despliegue.
MAINTENANCE_MODE=
